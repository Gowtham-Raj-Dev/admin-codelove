rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'gowthamraje1221@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function okMap(name) {
      return !(name in request.resource.data) || request.resource.data[name] is map;
    }

    // One document per site per day (IST): d/{YYYY-MM-DD}_{host_with_underscores}
    match /d/{id} {
      allow read: if isOwner();
      allow create, update: if id.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]_(([a-z0-9-]+_)*codelove_in|localhost)$')
        && request.resource.data.keys().hasOnly(['t', 'p', 'h', 'r', 'dev', 'tz', 'clk', 'br', 'live'])
        && okMap('t') && okMap('p') && okMap('h') && okMap('r') && okMap('dev')
        && okMap('tz') && okMap('clk') && okMap('br') && okMap('live')
        && (!('t' in request.resource.data) || request.resource.data.t.keys().hasOnly(['v', 'u', 'n', 's', 'sec', 'c']));
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
