rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'gowthamraje1221@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function okMap(name) {
      return !(name in request.resource.data) || request.resource.data[name] is map;
    }

    // One document per site per day (IST): d/{YYYY-MM-DD}_{host_with_underscores}
    match /d/{id} {
      allow read: if isOwner();
      allow create, update: if id.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]_(([a-z0-9-]+_)*codelove_in|localhost)$')
        && request.resource.data.keys().hasOnly(['t', 'p', 'h', 'r', 'dev', 'tz', 'clk', 'br', 'live'])
        && okMap('t') && okMap('p') && okMap('h') && okMap('r') && okMap('dev')
        && okMap('tz') && okMap('clk') && okMap('br') && okMap('live')
        && (!('t' in request.resource.data) || request.resource.data.t.keys().hasOnly(['v', 'u', 'n', 's', 'sec', 'c']));
      allow delete: if isOwner();
    }

    // APK download counts for apps.codelove.in: ONE public doc dl/apps = { n: { <appId>: count } }.
    // Anyone may read it; a write may only add exactly 1 to exactly one app id.
    function okAppId(k) {
      return k is string && k.matches('^[a-z0-9-]{1,40}$');
    }
    match /dl/{id} {
      allow read: if id == 'apps';
      allow create: if id == 'apps'
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is map
        && request.resource.data.n.keys().size() == 1
        && okAppId(request.resource.data.n.keys()[0])
        && request.resource.data.n[request.resource.data.n.keys()[0]] == 1;
      allow update: if id == 'apps'
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is map
        && request.resource.data.n.diff(resource.data.n).affectedKeys().size() == 1
        && okAppId(request.resource.data.n.diff(resource.data.n).affectedKeys().toList()[0])
        && request.resource.data.n[request.resource.data.n.diff(resource.data.n).affectedKeys().toList()[0]]
           == resource.data.n.get(request.resource.data.n.diff(resource.data.n).affectedKeys().toList()[0], 0) + 1;
      allow delete: if isOwner();
    }

    // Daily reports made by the admin dashboard (Reports page). Owner only.
    //   reports/{YYYY-MM-DD[_host]}           small summary (History list)
    //   reports/{YYYY-MM-DD[_host]}/body/main  markdown + report JSON
    match /reports/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && id.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9](_[a-z0-9.-]{1,80})?$')
        && request.resource.data.keys().hasOnly(['date', 'site', 'createdAt', 'range', 'summary', 'bytes']);
      match /body/{part} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner() && part == 'main'
          && request.resource.data.keys().hasOnly(['md', 'data', 'problems']);
      }
    }

    // Public site directory of the Pulse product (pulse-codelove): sites whose owner chose "show on the home page".
    // Anyone can read. Only the signed-in user who published a site can change or remove it (the admin can remove any).
    function okDir(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['host', 'name', 'desc', 'uid', 'at'])
        && d.host is string && d.host.matches('^[a-z0-9.-]{3,100}$') && id == d.host.replace('\\.', '_')
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.desc is string && d.desc.size() <= 160
        && d.uid == request.auth.uid && d.at is number;
    }
    match /directory/{id} {
      allow read: if true;
      allow create: if request.auth != null && okDir(id);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && okDir(id);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isOwner());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
